PORT=5000
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zglowra_db
JWT_SECRET=zglowra_super_secret_jwt_key_2026_bodycare
CLIENT_URL=http://localhost:5173

# Konfigurasi Penguncian Jarak Jauh (Google Spreadsheet Remote Lock)
# Ubah LICENSE_CHECK_ENABLED=true untuk mengaktifkan fitur penguncian via Google Sheet
LICENSE_CHECK_ENABLED=true
# Contoh URL CSV Google Sheet: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/export?format=csv
LICENSE_SHEET_URL=https://docs.google.com/spreadsheets/d/1EjDOuma5EaKnfYzvh_PxV7gU_v4r5Ysi3KdVmKgu3Og/export?format=csv
# Waktu cache status dalam detik (agar performa tetap cepat)
LICENSE_CACHE_SECONDS=15
# Mode jika internet client tidak terhubung: 'open' (tetap buka) atau 'locked' (harus ada internet)
LICENSE_FAIL_MODE=open


